{
  "info": {
    "name": "Módulo 8 - API REST JWT Upload",
    "_postman_id": "modulo8-node-express-jwt",
    "description": "Colección final del proyecto integrador.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST Login correcto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"Demo1234\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "POST Login incorrecto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"incorrecta\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "GET Perfil CON token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/perfil"
          }
        },
        {
          "name": "GET Perfil SIN token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/perfil"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "GET Usuarios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "POST Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Modulo 8\",\n  \"email\": \"modulo8@example.com\",\n  \"password\": \"Clave1234\"\n}"
            },
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "PUT Usuario 1 CON token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez API\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/1"
          }
        },
        {
          "name": "PUT Usuario 1 SIN token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No debería funcionar\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/1"
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "GET Pedidos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "POST Pedido CON token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"descripcion\": \"Pedido módulo 8\",\n  \"total\": 12500,\n  \"estado\": \"pendiente\"\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "POST Upload CON token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/upload"
          }
        },
        {
          "name": "POST Upload SIN token",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/upload"
          }
        }
      ]
    }
  ]
}